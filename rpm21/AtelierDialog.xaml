<Window x:Class="rpm21.AtelierDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:rpm21"
        mc:Ignorable="d"
        Title="AtelierDialog" Height="450" Width="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="lblTitle" Text="Добавление ателье" 
                   FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <Border Grid.Row="1" BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Номер:" FontWeight="Bold"/>
                <TextBox x:Name="txtNumber" Grid.Column="1"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Название:" FontWeight="Bold"/>
                <TextBox x:Name="txtName" Grid.Column="1"/>
            </Grid>
        </Border>

        <Border Grid.Row="3" BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Адрес:" FontWeight="Bold"/>
                <TextBox x:Name="txtAddress" Grid.Column="1"/>
            </Grid>
        </Border>

        <Border Grid.Row="4" BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Телефон:" FontWeight="Bold"/>
                <TextBox x:Name="txtPhone" Grid.Column="1"/>
            </Grid>
        </Border>

        <Border Grid.Row="5" BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Путь к фото:" FontWeight="Bold"/>
                <TextBox x:Name="txtPhotoPath" Grid.Column="1" Text="/Images/atelier1.jpg"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Сохранить" Width="100" Height="35" Margin="10" Click="BtnSave_Click" 
                    Background="#27AE60" Foreground="White"/>
            <Button Content="Отмена" Width="100" Height="35" Margin="10" Click="BtnCancel_Click" 
                    Background="#E74C3C" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
