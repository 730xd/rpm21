<Window x:Class="rpm21.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:rpm21"
        mc:Ignorable="d"
        Title="LoginWindow" Height="450" Width="800">
    <Grid Background="#2C3E50">
        <Border Background="White" CornerRadius="15" Width="350" Height="350" 
                HorizontalAlignment="Center" VerticalAlignment="Center">

            <StackPanel Margin="20">
                <TextBlock Text="АТЕЛЬЕ" FontSize="24" FontWeight="Bold" 
                           HorizontalAlignment="Center" Foreground="#2C3E50"/>
                <TextBlock Text="Вход в систему" HorizontalAlignment="Center" 
                           Margin="0,0,0,20" Foreground="#7F8C8D"/>

                <TextBox x:Name="txtLogin" Height="35" Margin="0,10" 
                         Tag="Логин" FontSize="14"/>

                <PasswordBox x:Name="txtPassword" Height="35" Margin="0,10" 
                             FontSize="14"/>

                <Button x:Name="btnLogin" Content="ВОЙТИ" Height="40" Margin="0,20" 
                        Background="#27AE60" Foreground="White" FontSize="14" 
                        Click="BtnLogin_Click"/>

                <Button x:Name="btnGuest" Content="ВОЙТИ КАК ГОСТЬ" Height="35" 
                        Background="#95A5A6" Foreground="White" 
                        Click="BtnGuest_Click"/>

                <TextBlock x:Name="txtError" Foreground="Red" 
                           HorizontalAlignment="Center" Margin="0,10"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
