<Window x:Class="rpm21.ServicesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:rpm21"
        mc:Ignorable="d"
        Title="ServicesWindow" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Информация об ателье -->
        <Border Background="#2C3E50" CornerRadius="10" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock x:Name="txtAtelierName" Foreground="White" FontSize="18" FontWeight="Bold"/>
                <TextBlock x:Name="txtAtelierAddress" Foreground="#BDC3C7" FontSize="13" Margin="0,5,0,0"/>
                <TextBlock x:Name="txtAtelierPhone" Foreground="#BDC3C7" FontSize="13"/>
            </StackPanel>
        </Border>

        <!-- Кнопка добавления услуги -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10" HorizontalAlignment="Right">
            <Button x:Name="btnAddService" Content="Добавить услугу" Width="140" Height="32" Margin="5"
                    Click="BtnAddService_Click" Background="#27AE60" Foreground="White"
                    Cursor="Hand" FontWeight="Bold"/>
        </StackPanel>

        <!-- ListView -->
        <ListView x:Name="lvServices" Grid.Row="2" 
                 
                  BorderBrush="#BDC3C7" BorderThickness="1">

            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Код услуги" Width="100" DisplayMemberBinding="{Binding Service.Code}"/>
                    <GridViewColumn Header="Наименование услуги" Width="220" DisplayMemberBinding="{Binding Service.Name}"/>
                    <GridViewColumn Header="Длительность" Width="100" DisplayMemberBinding="{Binding Service.Duration}"/>
                    <GridViewColumn Header="Цена, руб" Width="100" DisplayMemberBinding="{Binding Price}"/>
                    <GridViewColumn Header="Действия" Width="120">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="Редакт" Width="50" Margin="2" 
                                            Click="BtnEditPrice_Click" Tag="{Binding}"
                                            Background="#F39C12" Foreground="White"/>
                                    <Button Content="Удалить" Width="50" Margin="2" 
                                            Click="BtnDeletePrice_Click" Tag="{Binding}"
                                            Background="#E74C3C" Foreground="White"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Статус бар -->
        <Border Grid.Row="3" Background="#ECF0F1" CornerRadius="5" Margin="0,10,0,0" Padding="10">
            <TextBlock x:Name="txtStatus" Text="Готово" Foreground="#34495E"/>
        </Border>
    </Grid>
</Window>
